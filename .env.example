NODE_ENV=development
PORT=3000
API_PREFIX=api/v2
CORS_ORIGINS=https://eeetik.app,https://www.eeetik.app
SITE_DOMAIN_ALLOWLIST=eeetik.app,www.eeetik.app
API_PUBLIC_BASE_URL=https://api.eeetik.app
WORKER_PUBLIC_BASE_URL=https://api1.eeetik.app
LOG_LEVEL=info
LOG_DIR=.local/logs

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_BLOCK_DURATION_MS=60000
THROTTLE_EXPENSIVE_TTL_MS=60000
THROTTLE_EXPENSIVE_LIMIT=30
THROTTLE_EXPENSIVE_BLOCK_DURATION_MS=60000
# Managed Redis/Mongo defaults for deployed environments.
# For local development overrides, see the commented block below.
THROTTLE_REDIS_HOST=redis.internal
THROTTLE_REDIS_PORT=6379
THROTTLE_REDIS_PASSWORD=
THROTTLE_REDIS_KEY_PREFIX=throttle

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/eeetik?retryWrites=true&w=majority
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=
STARTUP_DEPENDENCY_MAX_WAIT_MS=60000
STARTUP_DEPENDENCY_RETRY_INTERVAL_MS=2500
STARTUP_DEPENDENCY_PROBE_TIMEOUT_MS=3000

METADATA_CACHE_TTL_SECONDS=86400
METADATA_CACHE_URL_TTL_SECONDS=86400
METADATA_CACHE_UID_TTL_SECONDS=86400
METADATA_SINGLEFLIGHT_LOCK_TTL_MS=15000
METADATA_SINGLEFLIGHT_WAIT_RETRY_MS=150
METADATA_SINGLEFLIGHT_MAX_RETRIES=40

# MinIO Object Storage Configuration (S3-compatible)
# For Kubernetes deployment, MinIO runs as a service in the cluster
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=media-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
SIGNED_URL_TTL_SECONDS=600
STORAGE_MAX_MONTHLY_BYTES=10737418240

AD_HD_MIN_SECONDS=30
AD_SD_MIN_SECONDS=15
AD_AUDIO_MIN_SECONDS=10
AD_ZIP_MIN_SECONDS=20
