NODE_ENV=development
PORT=3000
API_PREFIX=api/v2
CORS_ORIGINS=https://your-miniapp.onrender.com
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
LOG_DIR=.local/logs

# ─── Redis connection (choose ONE of the three sources) ──────────────────────
# 1. Provider-style single URL (Heroku Redis, Redis Cloud, Render Key Value…).
#    Takes precedence over everything below; rediss:// enables TLS automatically:
# REDIS_URL=rediss://:password@ec2-host.compute.amazonaws.com:24829
# 2. Upstash Redis (free tier): https://console.upstash.com
#    REST is NOT used; copy endpoint + password from "Connect → Node.js (ioredis)".
UPSTASH_REDIS_HOST=your-db.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your_upstash_password
# TLS is enabled automatically for Upstash hosts; set to false only for local dev.
UPSTASH_REDIS_TLS=
# Local development fallback (used when UPSTASH_REDIS_HOST is empty):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Throttler-specific overrides (optional – inherit Upstash/Redis settings)
THROTTLE_REDIS_KEY_PREFIX=throttle
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_BLOCK_DURATION_MS=60000
THROTTLE_EXPENSIVE_TTL_MS=60000
THROTTLE_EXPENSIVE_LIMIT=30
THROTTLE_EXPENSIVE_BLOCK_DURATION_MS=60000
THROTTLE_DOMAIN_TTL_MS=60000
THROTTLE_DOMAIN_LIMIT=120
THROTTLE_UNIQUE_TTL_MS=60000
THROTTLE_UNIQUE_LIMIT=20

# ─── MongoDB (free tier: Atlas M0 or Render MongoDB) ─────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/eeetik?retryWrites=true&w=majority
STARTUP_DEPENDENCY_MAX_WAIT_MS=60000
STARTUP_DEPENDENCY_RETRY_INTERVAL_MS=2500
STARTUP_DEPENDENCY_PROBE_TIMEOUT_MS=3000

# ─── Telegram bot + Mini App ─────────────────────────────────────────────────
# 1. @BotFather → /newbot → copy the token
# 2. @BotFather → /newapp (or Bot Settings → Menu Button) → set the Mini App URL
TELEGRAM_BOT_TOKEN=123456789:AA-your-botfather-token
TELEGRAM_MINI_APP_URL=https://your-miniapp.onrender.com
# Optional: force a webhook URL (defaults to ${RENDER_EXTERNAL_URL}/${API_PREFIX}/bot/webhook)
TELEGRAM_WEBHOOK_URL=
# Secret token Telegram echoes back on every webhook call (recommended)
TELEGRAM_WEBHOOK_SECRET=
# Set to false to disable polling/webhook (e.g. on the worker service)
ENABLE_TELEGRAM_BOT=true
# TTL (seconds) for cached Telegram file_id entries
TELEGRAM_FILE_ID_CACHE_TTL=86400
# Telegram Bot API upload limit (bots: 50 MB, keep a safety margin)
TELEGRAM_MAX_UPLOAD_MB=49
# Fallback chat used for jobs without a chatId (e.g. REST-only prepares)
TELEGRAM_STORAGE_CHAT_ID=
# Max age (seconds) of accepted Mini App initData payloads
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# ─── Bot / Mini App auth ──────────────────────────────────────────────────────
# Shared secret for bot-internal REST calls (header: X-Bot-Secret)
BOT_INTERNAL_SECRET=generate-a-long-random-string-here
# JWT secret for POST /auth/telegram access tokens
JWT_SECRET=generate-another-long-random-string-here
JWT_EXPIRES_IN=7d

# ─── Appwrite (serverless architecture – see README → Appwrite) ──────────────
# The Mini App needs the PUBLIC_* values at build time:
# PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# PUBLIC_APPWRITE_PROJECT_ID=
# PUBLIC_FN_TG_BOT=tg-bot
# Secrets live as Appwrite function variables (Console → Functions → tg-bot/tg-processor):
# TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_ALLOWED_USER_IDS,
# TELEGRAM_MINI_APP_URL, TELEGRAM_STORAGE_CHAT_ID, APPWRITE_BUCKET_ID,
# APPWRITE_API_KEY
# Live values (verified): bot @eeetik_bot, owner 1673359993, bucket 6ad1172800034a06bcf5

# ─── Worker (ephemeral storage) ───────────────────────────────────────────────
TEMP_DOWNLOAD_DIR=/tmp/eeetik-downloads
WORKER_CONCURRENCY=2

# ─── Queue / cache tuning ─────────────────────────────────────────────────────
METADATA_CACHE_TTL_SECONDS=86400
METADATA_CACHE_URL_TTL_SECONDS=86400
METADATA_CACHE_UID_TTL_SECONDS=86400
CDN_URL_CACHE_TTL_SECONDS=3600
METADATA_SINGLEFLIGHT_LOCK_TTL_MS=15000
METADATA_SINGLEFLIGHT_WAIT_RETRY_MS=150
METADATA_SINGLEFLIGHT_MAX_RETRIES=40
DOWNLOAD_LOCK_TTL_MS=15000
DOWNLOAD_LOCK_WAIT_MS=7000
DOWNLOAD_LOCK_WAIT_POLL_MS=250
PREPARE_WAIT_TIMEOUT_MS=7000
PREPARE_WAIT_POLL_INTERVAL_MS=250

# ─── Legacy local-disk mode (optional, off by default) ───────────────────────
# STORAGE_BACKEND=telegram  # 'telegram' (default) | 'local'
# Only used when STORAGE_BACKEND=local:
# STORAGE_PATH=./data/uploads
# STORAGE_MAX_MONTHLY_BYTES=10737418240
# URL_SIGNING_SECRET=your-secret-key-minimum-32-characters-long-for-security
# SIGNED_URL_EXPIRY_SECONDS=600

# Ad-gate thresholds (only enforced for unauthenticated callers – the bot and
# the Mini App are verified via BotOrMiniAppGuard and skip the gate)
AD_HD_MIN_SECONDS=30
AD_SD_MIN_SECONDS=15
AD_AUDIO_MIN_SECONDS=10
AD_ZIP_MIN_SECONDS=20
