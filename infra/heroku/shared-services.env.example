# Copy to a private file (for example infra/heroku/shared-services.env) and fill real values.
# Do not commit the filled file to source control.
MONGO_URI=mongodb+srv://mongo-user:mongo-pass@cluster.mongodb.net/eeetik?retryWrites=true&w=majority
# Keep this as the private R2 S3 endpoint (no public r2.dev/demo URL).
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=media-private
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
STORAGE_MAX_MONTHLY_BYTES=10737418240
# Used for CDN-signed URL generation (SIGNED_URL_MODE=cdn).
CDN_SIGNING_SECRET=your-cdn-signing-secret
