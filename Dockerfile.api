FROM node:22-alpine AS deps
WORKDIR /app

# Install build dependencies for canvas and other native modules
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev

COPY package*.json ./
RUN npm ci

FROM deps AS build
COPY . .
RUN npm run build:shared && npm run build:api

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Install build dependencies for npm install (canvas needs to rebuild)
# and runtime dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev \
    cairo \
    jpeg \
    pango \
    giflib \
    pixman

COPY package*.json ./
RUN npm ci --omit=dev

# Clean up build dependencies to reduce image size
RUN apk del python3 make g++ cairo-dev jpeg-dev pango-dev giflib-dev pixman-dev

COPY --from=build /app/dist ./dist
CMD ["node", "dist/apps/eeetik_backend/main"]
